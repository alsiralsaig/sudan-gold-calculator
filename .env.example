# نسخ هذا الملف إلى .env.local واملأ القيم

# عنوان مشروع Supabase (يظهر في إعدادات المشروع > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# مفتاح الخدمة (Service Role) — لا يُشارك ولا يُرفع إلى GitHub أبداً
# يُستخدم على الخادم فقط لحفظ بيانات المستخدمين والمزامنة
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# مفتاح توقيع جلسات الدخول (16 حرفاً على الأقل)
# يمكن توليده بأمر: openssl rand -hex 32
AUTH_SECRET=change-this-to-a-long-random-string

# (اختياري) بيئة التشغيل: production / development
# NODE_ENV=production
